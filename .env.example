# Copy to .env and adjust. Every backend setting is NEXUS_-prefixed (see backend/nexus/core/config.py).

# --- models (local Ollama only) ---
# lite     : llama3.2:3b for every role (~2.5 GB resident) — default, safe on a busy 16 GB Mac
# standard : qwen2.5-coder:7b main + llama3.2:3b fast (~7.5 GB resident)
NEXUS_MODEL_PROFILE=lite
# Per-role overrides win over the profile:
# NEXUS_MODEL_MAIN=qwen2.5-coder:7b
# NEXUS_MODEL_FAST=llama3.2:3b
# NEXUS_MODEL_EMBED=nomic-embed-text
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_NUM_CTX=8192
NEXUS_LLM_MAX_CONCURRENCY=2

# --- server ---
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_PUBLIC_URL=http://127.0.0.1:8000
NEXUS_UI_URL=http://localhost:3000
NEXUS_LOG_LEVEL=INFO

# --- approvals & email (Mailpit captures mail locally: http://localhost:8025) ---
# Signs one-time approval links. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
NEXUS_SECRET_KEY=change-me
NEXUS_SMTP_HOST=127.0.0.1
NEXUS_SMTP_PORT=1025
NEXUS_OWNER_EMAIL=owner@nexus.local

# --- sandbox ---
# docker (isolated, no network) | local (subprocess fallback, NOT isolated — dev only)
NEXUS_SANDBOX_BACKEND=docker

# --- optional GitHub Issues adapter for the Ticket Solver ---
# NEXUS_GITHUB_TOKEN=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
