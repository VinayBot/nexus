# Copy to .env and adjust. Every backend setting is NEXUS_-prefixed (see backend/nexus/core/config.py).

# --- models (local Ollama only) ---
# lite     : llama3.2:3b for every role (~3 GB resident) — safest on a busy 16 GB Mac
# balanced : qwen2.5:3b main/fast + qwen2.5-coder:3b code, llama3.2:3b fallback (~5 GB) — recommended
# standard : qwen2.5-coder:7b main + llama3.2:3b fast (~7.5 GB resident) — not recommended on 16 GB
# The profile picked in Settings → Models is saved (data/model_profile.json) and wins over this.
NEXUS_MODEL_PROFILE=lite
# ollama (default) | simulation (scripted model for offline demos and e2e — UI shows a SIMULATION badge)
NEXUS_LLM_PROVIDER=ollama
# Per-role overrides win over the profile:
# NEXUS_MODEL_MAIN=qwen2.5-coder:7b
# NEXUS_MODEL_FAST=llama3.2:3b
# NEXUS_MODEL_EMBED=nomic-embed-text
# NEXUS_MODEL_CODE=qwen2.5-coder:3b
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_NUM_CTX=8192
NEXUS_LLM_MAX_CONCURRENCY=2

# --- server ---
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_PUBLIC_URL=http://127.0.0.1:8000
NEXUS_UI_URL=http://localhost:3000
NEXUS_LOG_LEVEL=WARNING

# --- accounts & roles (owner / operator / viewer) ---
# On first visit NEXUS asks you to create the owner account. To seed accounts instead:
# NEXUS_BOOTSTRAP_USERS=alice:a-long-password:owner,bob:another-password:operator
NEXUS_AUTH_ENABLED=true
NEXUS_TOKEN_TTL_HOURS=12

# --- approvals & email (Mailpit captures mail locally: http://localhost:8025) ---
# Signs login sessions and one-time approval links. Leave as is and NEXUS generates a strong
# random key on first start (data/secret.key), or set your own (32+ characters):
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
NEXUS_SECRET_KEY=change-me
NEXUS_SMTP_HOST=127.0.0.1
NEXUS_SMTP_PORT=1025
NEXUS_OWNER_EMAIL=owner@nexus.local
# Mission results are emailed here (also editable in Settings -> Email results):
# NEXUS_RESULT_EMAIL=you@example.com
# Real delivery instead of Mailpit: easiest is Settings -> Email results -> Connect Gmail
# (paste a Gmail App Password). Or set it here:
# NEXUS_SMTP_HOST=smtp.gmail.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_STARTTLS=true
# NEXUS_SMTP_USERNAME=you@gmail.com
# NEXUS_SMTP_PASSWORD=your-16-letter-app-password

# --- sandbox ---
# docker (isolated, no network) | local (subprocess fallback, NOT isolated — dev only)
NEXUS_SANDBOX_BACKEND=docker

# --- optional GitHub Issues adapter for the Ticket Solver ---
# NEXUS_GITHUB_TOKEN=

# --- frontend ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ReAct workers: native (provider tool calling, default) or json (schema-constrained turns)
NEXUS_REACT_MODE=native
